{
  "name": "the-weight-of-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/showcase-prepare.mjs && node scripts/showcase.mjs catalog",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/showcase-prepare.mjs && node scripts/collection.mjs catalog && node scripts/showcase.mjs catalog",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "package:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-template.ps1",
    "verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-package.ps1",
    "collection:status": "node scripts/collection.mjs status",
    "collection:check": "node scripts/collection.mjs check all",
    "collection:audit": "node scripts/collection.mjs audit-public",
    "renderer:replay": "node scripts/renderer-replay.mjs",
    "renderer:register": "node scripts/renderer-register.mjs",
    "production:check": "node scripts/production-run.mjs webart.production.session.json --check",
    "production:session": "node scripts/production-run.mjs webart.production.session.json --session --publish",
    "production:queue": "node scripts/production-run.mjs webart.production.session.json --session --queue-only --publish",
    "prototype:step": "node scripts/prototype-run.mjs",
    "workflow:step": "node scripts/workflow-step.mjs",
    "workflow:status": "node scripts/workflow-step.mjs --status",
    "test:review": "node --test scripts/session-review.test.mjs",
    "test:collection": "node --test scripts/collection.test.mjs scripts/preview.test.mjs scripts/staging.test.mjs scripts/showcase.test.mjs",
    "release": "node scripts/release-collection.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
