  "findings": [
    {
      "role": "hand",
      "result": "reject",
      "finding": "The WebXR input hand is a low-detail input visualization. Nails and knuckle anatomy are absent; curled fingertips show faceted collapsed forms and the wrist ends as a flat severed cap. This cannot stand in for the source hand at final phone scale."
    },
    {
      "role": "cork",
      "result": "reject",
      "finding": "Uniform fine noise and overexposed amber color flatten the coarse/fine cork flakes. The sidewall does not show the required material character; the plate shape alone cannot grant acceptance."
    },
    {
      "role": "beans",
      "result": "reject",
      "finding": "The repeated smooth surface and bright candy-like highlights read as plastic beans. A central groove exists but does not compensate for the lack of roasted skin, wrinkling, varied tone and close-up craft."
    },
    {
      "role": "composition",
      "result": "reject",
      "finding": "The tablet macro is cropped without a deliberate frame, and desk tools remain visible during the floating material state. The source transition requires an intentional isolated object, not leftover prop geometry."
    }
  ],
  "nextAction": "replace-insufficient-assets-before-page-implementation",
  "limitations": "Current conversation assisted visual audit, not independent model review or user acceptance.",
